---
/**
 * Homepage layout, kept out of index.mdx on purpose.
 *
 * MDX renders a `<style>` tag where it is written: in the body, after the
 * markup. The players upgrade and fit themselves as they are parsed, so they
 * measured the full content width, and only then did this stylesheet parse and
 * narrow the job columns — leaving every demo diagram fitted to a width that no
 * longer existed. Astro hoists a component's styles into <head>, so the grid is
 * in force before anything renders.
 *
 * `is:global` because the classes below are used by index.mdx, which does not
 * carry this component's scoping attribute.
 */
---

<style is:global>
  /* =================================================================
     HOMEPAGE
     The hero hands over working code. Everything below shows the
     product doing a job rather than describing one.
     ================================================================= */

  .home {
    --gap: var(--space-xl);
    display: grid;
    gap: var(--gap);
    padding: var(--space-xl) 0 var(--space-3xl);
    font-family: var(--font-body);
    color: var(--ink-2);
  }

  /* ---------- HERO ---------- */
  .home__hero {
    display: grid;
    gap: var(--space-md);
    max-width: 60ch;
  }

  .home__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .home__eyebrow-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--accent), transparent 80%);
    animation: home-pulse 2.4s var(--ease-out-quart) infinite;
  }
  @keyframes home-pulse {
    0%, 70%, 100% {
      box-shadow: 0 0 0 4px color-mix(in oklch, var(--accent), transparent 80%);
    }
    35% {
      box-shadow: 0 0 0 8px color-mix(in oklch, var(--accent), transparent 92%);
    }
  }

  .home__title {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 96;
    font-weight: 600;
    font-size: var(--text-display-sm);
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-1);
    text-wrap: balance;
  }

  .home__title-em {
    font-style: italic;
    font-weight: 500;
    color: var(--accent);
  }

  .home__lede {
    margin: 0;
    max-width: 52ch;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* ---------- STAGE ---------- */
  .home__stage {
    display: grid;
    gap: var(--space-sm);
  }

  /* ---------- PATTERN ----------
     The one-glance pitch: the diagram playing, and directly under it the exact
     markup that produced it. Full width rather than two columns — halved, the
     control bar drops its labels to icons and the CDN line scrolls out of
     sight, which is the opposite of the point. */
  .home__pattern {
    display: grid;
    gap: var(--space-md);
    border-top: 1px solid var(--line-1);
    padding-top: var(--space-lg);
  }

  .home__pattern-demo {
    min-width: 0;
    background: var(--surface-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .home__pattern-demo :global(mermaid-flow-player) {
    width: 100%;
  }

  /* Expressive Code owns the frame; it just must not add its page margin
     here, where the grid does the spacing. */
  .home__pattern-code {
    min-width: 0;
  }

  .home__pattern-code :global(.expressive-code) {
    margin: 0;
  }

  .home__pattern-meta {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-3);
  }

  /* ---------- STAGE ---------- */
  .home__stage-title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    color: var(--ink-1);
  }

  /* ---------- JOBS ---------- */
  .home__jobs {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line-1);
    padding-top: var(--space-lg);
  }

  .home__jobs-head {
    margin-bottom: var(--space-lg);
  }

  .home__jobs-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: var(--tracking-snug);
    color: var(--ink-1);
  }

  .home__job {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--line-1);
  }

  @media (min-width: 900px) {
    .home__job {
      grid-template-columns: minmax(0, 34ch) minmax(0, 1fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .home__job-text h3 {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--ink-1);
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
  }

  .home__job-text p {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-3);
  }

  .home__job-meta {
    font-size: var(--text-xs) !important;
    color: var(--ink-4) !important;
  }

  .home__job-text code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 0.1em 0.34em;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    border: 1px solid var(--line-1);
    color: var(--ink-1);
  }

  .home__job-demo {
    min-width: 0;
    background: var(--surface-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .home__job-demo :global(mermaid-flow-player) {
    width: 100%;
  }

  /* ---------- MORE ---------- */
  .home__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    border-top: 1px solid var(--line-1);
    padding-top: var(--space-lg);
  }

  .home__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.5rem;
    padding: 0 var(--space-md);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 200ms var(--ease-out-expo),
      background-color 200ms var(--ease-out-expo),
      border-color 200ms var(--ease-out-expo),
      color 200ms var(--ease-out-expo);
  }

  .home__btn:hover { transform: translateY(-1px); }
  .home__btn:active { transform: translateY(0); }

  .home__btn--primary {
    background: var(--ink-1);
    color: var(--surface-0);
    border: 1px solid var(--ink-1);
  }
  .home__btn--primary:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: var(--accent-foreground);
  }
  .home__btn--primary svg {
    transition: transform 220ms var(--ease-out-expo);
  }
  .home__btn--primary:hover svg {
    transform: translateX(3px);
  }

  .home__btn--ghost {
    background: transparent;
    color: var(--ink-1);
    border: 1px solid var(--line-2);
  }
  .home__btn--ghost:hover {
    border-color: var(--ink-1);
    background: var(--surface-2);
  }

  .home__btn--quiet {
    background: transparent;
    color: var(--ink-3);
    border: 1px solid transparent;
    padding-inline: var(--space-xs);
  }
  .home__btn--quiet:hover {
    color: var(--ink-1);
    background: var(--surface-2);
  }

  /* ---------- SPLASH TEMPLATE OVERRIDES ----------
     Starlight's splash template injects a built-in hero block.
     We render our own hero, so suppress the default. */
  :global(.hero) {
    display: none !important;
  }
</style>
